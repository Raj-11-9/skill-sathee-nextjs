# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Contact form delivery via Resend (https://resend.com) - recommended
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@your-domain.com
CONTACT_FROM_EMAIL="Skill-Sathee <noreply@your-domain.com>"

# Optional: also forward each enquiry to a webhook (Slack, Zapier, Make, Google Apps Script...)
CONTACT_WEBHOOK_URL=
